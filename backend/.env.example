# Read automatically from backend/.env. Never commit actual keys or databases.
KINGCAREER_DATA_DIR=backend/storage
KINGCAREER_PUBLIC_ORIGIN=http://127.0.0.1:8000
KINGCAREER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
KINGCAREER_COOKIE_SECURE=false
KINGCAREER_SESSION_DAYS=7
# Leave template mode for the model-free application.
KINGCAREER_AI_MODE=template
KINGCAREER_AI_PROVIDER=gemini
KINGCAREER_AI_URL=
KINGCAREER_AI_MODEL=gemini-3.8-flash
KINGCAREER_AI_KEY=
