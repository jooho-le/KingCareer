# Server-only deployment settings. Copy to deployment.env (gitignored).
# Do not use a VITE_ prefix for database credentials or model keys.
# Supabase Connect > Transaction pooler (port 6543), percent-encode password.
KINGCAREER_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=require
KINGCAREER_DATABASE_SCHEMA=kingcareer
KINGCAREER_PUBLIC_ORIGIN=https://YOUR-PROJECT.vercel.app
KINGCAREER_ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
KINGCAREER_COOKIE_SECURE=true
KINGCAREER_AI_MODE=template
KINGCAREER_AI_PROVIDER=gemini
KINGCAREER_AI_MODEL=gemini-3.5-flash-lite
KINGCAREER_AI_KEY=
